{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birthday-reminder",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // The reminder engine runs every minute and is idempotent.
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_BASE_URL": "http://localhost:8443"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-reminder",
      // The default (local) environment never deploys, so this id is unused;
      // `wrangler dev --local` serves a local database instead.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "birthday-reminder-photos"
    }
  ],

  // Deploy with `wrangler deploy --env staging` or `--env production`.
  // Named environments do not inherit bindings, vars or triggers.
  "env": {
    "staging": {
      "name": "birthday-reminder-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        // Used to build password-reset links.
        "APP_BASE_URL": "https://birthday-reminder-staging.jpaypay17.workers.dev"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "birthday-reminder-staging",
          "database_id": "287fb6d2-02a9-4c0e-8bcf-ce9464e6fdc9",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "birthday-reminder-photos-staging"
        }
      ]
    },
    "production": {
      "name": "birthday-reminder",
      "vars": {
        "ENVIRONMENT": "production",
        // Replace with a custom domain when one is attached.
        "APP_BASE_URL": "https://birthday-reminder.jpaypay17.workers.dev"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "birthday-reminder",
          "database_id": "12220dcc-c1bd-441b-bf8c-fec98e1a951e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "birthday-reminder-photos"
        }
      ]
    }
  }
}
