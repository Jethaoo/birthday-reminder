{
  "name": "birthday-reminder-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply birthday-reminder --local",
    "db:migrate:remote": "wrangler d1 migrations apply birthday-reminder --remote"
  },
  "dependencies": {
    "hono": "^4.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250923.0",
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
