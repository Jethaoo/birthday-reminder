# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.idea/
.vscode/
*.iml
*.swp

# Node / Cloudflare Worker
node_modules/
dist/
.wrangler/
*.tsbuildinfo

# Flutter / Dart
app/.dart_tool/
app/build/
app/android/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/local.properties

# Secrets — never commit.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# The template is safe to publish; the filled-in file next to it is not.
!.dev.vars.example
secrets/
*.pem
*.key
*.p12
**/firebase-service-account*.json
**/service-account*.json
# Firebase downloads keys as <project>-firebase-adminsdk-*.json by default.
**/*firebase-adminsdk*.json
**/*-adminsdk-*.json

# Android signing keys
*.jks
*.keystore
app/android/key.properties

# Firebase Android config. It carries a Google API key, which GitHub secret
# scanning reports even though Google restricts it to this package. Each
# checkout supplies its own — the Gradle plugin is only applied when it exists.
app/android/app/google-services.json
**/GoogleService-Info.plist

# Logs and caches
*.log
logs/
.cache/
