<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window, before Flutter draws its first frame. The mark itself is
     drawn by the launch sequence in Dart, so this only has to be the same
     background colour: anything more would flash before that sequence starts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/app_background" />
</layer-list>
