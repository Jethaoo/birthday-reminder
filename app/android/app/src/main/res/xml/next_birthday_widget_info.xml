<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2x2 countdown: one person, the number of days to go.

  `updatePeriodMillis` is 0 because the app schedules the refreshes it actually
  needs (the next local midnights) through home_widget. Every render recomputes
  the day count from the device date, so a late refresh still shows the right
  number.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_next_birthday_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:resizeMode="none"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
